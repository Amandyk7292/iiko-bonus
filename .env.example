PORT=3000
NODE_ENV=development

# Домены, которым разрешен browser CORS. Через запятую.
# Оставьте пустым только для локальной разработки.
ALLOWED_ORIGINS=https://your-admin-domain.example,https://your-app-domain.example

# Обязательные секреты. Сгенерируйте длинные случайные значения.
API_SECRET=replace-with-at-least-32-random-characters
# Keep compatibility until every active branch has its own POS credential and
# terminal configuration; then switch to required (see docs/loyalty-pos-auth-rollout.md).
LOYALTY_BRANCH_POS_ENFORCEMENT=compatibility
# POS fraud-containment limits. Rolling values cover each authenticated branch
# over the preceding 24 hours and are enforced atomically in PostgreSQL.
LOYALTY_POS_MAX_ORDER_TOTAL=250000
LOYALTY_POS_MAX_DISCOUNT_AMOUNT=100000
LOYALTY_POS_MAX_EARNED_BONUS=25000
LOYALTY_POS_BRANCH_ROLLING_ORDER_COUNT=2000
LOYALTY_POS_BRANCH_ROLLING_ORDER_TOTAL=25000000
LOYALTY_POS_BRANCH_ROLLING_DISCOUNT_AMOUNT=2000000
LOYALTY_POS_BRANCH_ROLLING_EARNED_BONUS=1250000
# Предпочтительно: массив пользователей с bcrypt-хешами и TOTP secret (base32).
# Хеш: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password"
ADMIN_USERS_JSON=[{"username":"admin","passwordHash":"$2b$12$replace","role":"admin","totpSecret":"BASE32SECRET"}]
ADMIN_REQUIRE_MFA=true
# Persistent per-admin rolling 24-hour limits for monetary gift-card issuance.
ADMIN_GIFT_CARD_DAILY_AMOUNT_LIMIT=2000000
ADMIN_GIFT_CARD_DAILY_COUNT_LIMIT=20
# Обратная совместимость для локальной разработки (в production не рекомендуется):
# ADMIN_PASSWORD=replace-with-at-least-12-random-characters
BULKA_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_JWT_SECRET=replace-with-at-least-32-random-characters
# Необязательно: отдельный ключ admin JWT. Если пусто, используется
# криптографически отделённый ключ, производный от CUSTOMER_JWT_SECRET.
ADMIN_JWT_SECRET=
# Допустимо 10-14; 12 — production-значение по умолчанию.
CUSTOMER_PASSWORD_BCRYPT_ROUNDS=12

# =======================
# Настройки Supabase
# =======================
# Ваш Project URL из настроек Supabase (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Ваш Service Role Key (Settings -> API). ВАЖНО: используйте service_role key, а не anon key!
SUPABASE_SERVICE_ROLE_KEY=ey...

# PostgreSQL connection string only for `npm run db:migrate`.
# Do not expose it in the mobile app or browser. It is not required by the API at runtime.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Set to false only for a local PostgreSQL instance without TLS.
SUPABASE_DB_SSL=true

# (Опционально) Данные для iiko API, если они нужны
IIKO_API_LOGIN=ваш_логин
IIKO_API_PASSWORD=ваш_пароль
# Внешнее меню — основной источник опубликованных на сайте товаров и цен.
# Укажите ID из iikoWeb, если у организации доступно несколько внешних меню.
IIKO_EXTERNAL_MENU_ID=
IIKO_EXTERNAL_MENU_NAME=
# Чтобы цены менялись автоматически вместе с прайс-листом iiko, выберите
# «Ценовые категории» в настройках API-логина. Если доступна одна категория,
# сайт выберет её сам; при нескольких укажите ID или точное название.
IIKO_PRICE_CATEGORY_ID=
IIKO_PRICE_CATEGORY_NAME=
# Сайт автоматически перечитывает опубликованные цены iiko. По умолчанию
# валидное меню обновляется не реже чем раз в 5 минут, пустое — раз в минуту.
IIKO_MENU_CACHE_TTL_SECONDS=300
IIKO_EMPTY_MENU_CACHE_TTL_SECONDS=60
# Отдельный iiko Cloud для филиалов Астаны. Основные IIKO_* остаются профилем
# для остальных городов. Безопасный VPS-скрипт сам определяет organization/menu.
IIKO_ASTANA_API_LOGIN=
IIKO_ASTANA_ORGANIZATION_ID=
IIKO_ASTANA_EXTERNAL_MENU_ID=
IIKO_ASTANA_EXTERNAL_MENU_NAME=
IIKO_ASTANA_PRICE_CATEGORY_ID=
IIKO_ASTANA_PRICE_CATEGORY_NAME=
# Если оставить пустыми, Астана использует общие IIKO_APP_ID и
# IIKO_CLIENT_SECRET. Заполняйте только для отдельного приложения iiko.
IIKO_ASTANA_APP_ID=
IIKO_ASTANA_CLIENT_SECRET=

# Wallet / Push
# Apple Pass Type certificate, private key and WWDR certificate as base64.
WALLET_CERT=
WALLET_KEY=
WALLET_WWDR=
WALLET_KEY_PASSPHRASE=
WALLET_AUTH_SECRET=replace-with-at-least-32-random-characters
WALLET_APNS_PRODUCTION=true
APPLE_PASS_TYPE_ID=pass.com.bulka.bonus
APPLE_WALLET_TEAM_ID=GKRRT4JU9G
# Google Wallet issuer/class plus service-account JSON.
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_ID=bulka_bonus_card
GOOGLE_CREDENTIALS_JSON=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_API_KEY=
# ActivityKit remote updates (Apple Developer APNs .p8 key).
APPLE_APNS_TEAM_ID=
APPLE_APNS_KEY_ID=
APPLE_APNS_PRIVATE_KEY=
APPLE_APNS_BUNDLE_ID=com.bulka.bonus

# Optional app/plugin URLs
ANDROID_BASE_URL=https://bulka.com.kz
IIKO_LOYALTY_API_BASE_URL=https://bulka.com.kz/api/loyalty
PUBLIC_BASE_URL=https://bulka.com.kz
RECEIPT_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Срок действия публичной ссылки на чек, по умолчанию 30 дней.
RECEIPT_LINK_TTL_SECONDS=2592000
# Включайте только временно при переходе со старых бессрочных ссылок.
RECEIPT_ALLOW_LEGACY_LINKS=false
ADMIN_MANUAL_BONUS_LIMIT=1000000
DELEGATED_MANUAL_BONUS_LIMIT=100000
LOG_LEVEL=info
# Optional authenticated Prometheus endpoint: GET /internal/metrics
METRICS_BEARER_TOKEN=
READINESS_TIMEOUT_MS=3000
# Optional HTTPS webhook for critical worker failures and stale workers.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_BEARER_TOKEN=
# ForteBank TXPG PaymentGateway. Данные выдаёт банк для составного Basic Auth.
# Пароль храните только в .env/VPS secret store и никогда не добавляйте в Git.
FORTE_ENABLED=false
FORTE_API_USERNAME=
FORTE_API_PASSWORD=
FORTE_MERCHANT_ID=
# Отдельный случайный секрет длиной не менее 32 символов для AES-GCM
# шифрования одноразовых паролей заказов, полученных от ForteBank.
FORTE_ORDER_CREDENTIAL_KEY=
FORTE_TEST_MODE=false
FORTE_API_BASE_URL=https://api.fortebank.com
FORTE_TIMEOUT_MS=15000
# Forte E-commerce Payment Widget / CTP API. Shop ID, Secret key и RSA public key
# берутся из личного кабинета Forte E-commerce. В production включайте только
# после проверки webhook-подписи и успешной тестовой оплаты.
FORTE_WIDGET_ENABLED=false
FORTE_WIDGET_CHECKOUT_ENABLED=true
FORTE_WIDGET_SHOP_ID=
FORTE_WIDGET_SECRET_KEY=
# Отдельный случайный секрет (минимум 32 символа) для AES-256-GCM шифрования
# checkout-токенов и токенов сохранённых карт.
FORTE_WIDGET_TOKEN_KEY=
# Необязательный стабильный идентификатор текущего ключа. При ротации сначала
# перенесите старый ключ в FORTE_WIDGET_TOKEN_PREVIOUS_KEYS, затем смените оба поля.
FORTE_WIDGET_TOKEN_KEY_ID=
# JSON-карта старых ключей для расшифровки уже сохранённых токенов:
# {"2026-06":"old-secret-at-least-32-characters"}
FORTE_WIDGET_TOKEN_PREVIOUS_KEYS=
# PEM с \n либо base64 DER публичного RSA-ключа магазина.
FORTE_WIDGET_WEBHOOK_PUBLIC_KEY=
FORTE_WIDGET_TEST_MODE=false
FORTE_WIDGET_APPLE_PAY_ENABLED=false
FORTE_WIDGET_CHECKOUT_API_URL=https://securepayments.fortebank.com
FORTE_WIDGET_TRANSACTION_API_URL=https://gateway.fortebank.com
YANDEX_MAPS_API_KEY=your_yandex_javascript_api_key
RUN_BACKGROUND_WORKERS=false
RUN_BOTS=true
# Обработчик надёжной очереди WhatsApp. На production оставьте true,
# на staging он принудительно выключается скриптом релиза.
RUN_WHATSAPP_OUTBOX_WORKER=true
ALLOW_WHATSAPP_QR_IN_LOGS=false
# Астана и весь Казахстан с 2024 года используют UTC+5.
ORDER_TIMEZONE_OFFSET_MINUTES=300
BULKA_TIMEZONE=Asia/Almaty

# Яндекс.Доставка для бизнеса. Токен выдается в кабинете Яндекс.Доставки
# на странице «Интеграция». Пока enabled=false, приложение работает без нее.
YANDEX_DELIVERY_ENABLED=false
# true — после принятия оплаченного заказа кухней создать и подтвердить заявку Яндекса.
# Оплата сама по себе курьера не вызывает.
YANDEX_DELIVERY_AUTO_DISPATCH=false
YANDEX_DELIVERY_API_TOKEN=
YANDEX_DELIVERY_BASE_URL=https://b2b.taxi.yandex.net
YANDEX_DELIVERY_SENDER_NAME=Bulka
YANDEX_DELIVERY_SENDER_PHONE=+77000000000
YANDEX_DELIVERY_COUNTRY=Казахстан
# Тариф courier допустим: обязательная опция auto_courier всё равно оставляет только автомобиль.
YANDEX_DELIVERY_TAXI_CLASS=courier
# auto_courier и thermobag всегда добавляются сервером и не могут быть отключены.
YANDEX_DELIVERY_CARGO_OPTIONS=auto_courier,thermobag
YANDEX_DELIVERY_SKIP_CONFIRMATION=true
YANDEX_DELIVERY_TIMEOUT_MS=15000
# Оставьте true на единственном VPS. В кластере включайте только на одном экземпляре.
RUN_YANDEX_DELIVERY_WORKER=true
# Без размеров конкретного товара используются эти безопасные значения на одну позицию.
YANDEX_DELIVERY_ITEM_LENGTH_M=0.30
YANDEX_DELIVERY_ITEM_WIDTH_M=0.25
YANDEX_DELIVERY_ITEM_HEIGHT_M=0.15
YANDEX_DELIVERY_ITEM_WEIGHT_KG=0.50

# Публичный WhatsApp Business номер для OTP (можно с +, пробелами и дефисами).
# Если не задан, API вернет whatsappPhone/whatsappUrl = null.
WHATSAPP_BUSINESS_PHONE=
# Защищённая magic-ссылка для оператора переписок. Храните только SHA-256 хеш
# 32-байтного base64url токена; сам токен передаётся оператору во фрагменте URL.
WHATSAPP_OPERATOR_ACCESS_TOKEN_HASH=
# Системный ffmpeg конвертирует запись браузера в OGG/Opus для voice note WhatsApp.
FFMPEG_PATH=ffmpeg

# ИИ-консультант отвечает только в личных чатах по Bulka в Астане.
# Ключ создайте в Google AI Studio и храните только в .env/VPS secrets.
GEMINI_ASSISTANT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER_KEY_ENCRYPTION_SECRET=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=500
GEMINI_HISTORY_TURNS=3
# Защита бесплатной квоты: запросы в минуту на чат и на весь бот.
GEMINI_CHAT_RPM=4
GEMINI_GLOBAL_RPM=10
GEMINI_DATA_CACHE_MS=600000
# Необязательно: подтверждённые владельцем факты (акции, правила заказа и т.п.).
GEMINI_BULKA_CONTEXT=

# Courier login: the courier opens the bot and sends a one-time identifier;
# the bot only replies to that incoming message. Sessions expire automatically.
COURIER_SESSION_HOURS=12

# Native Universal Links / Android App Links. Use the Apple Team ID and the
# Google Play app-signing certificate SHA-256 fingerprint (not the upload key).
APPLE_TEAM_ID=GKRRT4JU9G
APPLE_BUNDLE_ID=com.bulka.bonus
FIREBASE_WEB_VAPID_KEY=BItWENnHyRNy96PDaiO8Ga76xj3R0bc9ybb1WNNrxNiKuAJHjqOrO9Nqi6mZus4WUlQAYeZnAUyDogjSp46tfhI
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
# Терминальные группы нужны только для привязки остатков iiko к филиалам сайта.
IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=
IIKO_TERMINAL_GROUPS_JSON={}
