PORT=3000
NODE_ENV=development

# Домены, которым разрешен browser CORS. Через запятую.
# Оставьте пустым только для локальной разработки.
ALLOWED_ORIGINS=https://your-admin-domain.example,https://your-app-domain.example

# Обязательные секреты. Сгенерируйте длинные случайные значения.
API_TOKEN=replace-with-long-random-webhook-token
ADMIN_PASSWORD=replace-with-long-random-admin-token
BULKA_SECRET=replace-with-long-random-wallet-and-qr-secret

# =======================
# Настройки Supabase
# =======================
# Ваш Project URL из настроек Supabase (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Ваш Service Role Key (Settings -> API). ВАЖНО: используйте service_role key, а не anon key!
SUPABASE_SERVICE_ROLE_KEY=ey...

# (Опционально) Данные для iiko API, если они нужны
IIKO_API_LOGIN=ваш_логин
IIKO_API_PASSWORD=ваш_пароль

# =======================
# Интеграция с WhatsApp (Green API)
# =======================
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# Wallet / Push
WALLET_CERT=
WALLET_KEY=
WALLET_WWDR=
FIREBASE_SERVICE_ACCOUNT=

# Optional app/plugin URLs
ANDROID_BASE_URL=https://iiko-bonus.onrender.com
IIKO_LOYALTY_API_BASE_URL=https://iiko-bonus.onrender.com/api/loyalty
