PORT=3000
NODE_ENV=development

# Домены, которым разрешен browser CORS. Через запятую.
# Оставьте пустым только для локальной разработки.
ALLOWED_ORIGINS=https://your-admin-domain.example,https://your-app-domain.example

# Обязательные секреты. Сгенерируйте длинные случайные значения.
API_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
BULKA_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_JWT_SECRET=replace-with-at-least-32-random-characters

# =======================
# Настройки Supabase
# =======================
# Ваш Project URL из настроек Supabase (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Ваш Service Role Key (Settings -> API). ВАЖНО: используйте service_role key, а не anon key!
SUPABASE_SERVICE_ROLE_KEY=ey...

# PostgreSQL connection string only for `npm run db:migrate`.
# Do not expose it in the mobile app or browser. It is not required by the API at runtime.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Set to false only for a local PostgreSQL instance without TLS.
SUPABASE_DB_SSL=true

# (Опционально) Данные для iiko API, если они нужны
IIKO_API_LOGIN=ваш_логин
IIKO_API_PASSWORD=ваш_пароль

# Wallet / Push
WALLET_CERT=
WALLET_KEY=
WALLET_WWDR=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_API_KEY=

# Optional app/plugin URLs
ANDROID_BASE_URL=https://iiko-bonus.onrender.com
IIKO_LOYALTY_API_BASE_URL=https://iiko-bonus.onrender.com/api/loyalty
PUBLIC_BASE_URL=https://iiko-bonus.onrender.com
RUN_BACKGROUND_WORKERS=false
RUN_BOTS=true
ALLOW_WHATSAPP_QR_IN_LOGS=false

# Публичный WhatsApp Business номер для OTP (можно с +, пробелами и дефисами).
# Если не задан, API вернет whatsappPhone/whatsappUrl = null.
WHATSAPP_BUSINESS_PHONE=

# Kaspi POS Integration
KASPI_MICROSERVICE_URL=https://my-kaspi-pos.onrender.com
KASPI_WEBHOOK_SECRET=your_kaspi_webhook_secret_here

# Данные сессии кассира Kaspi (получите после авторизации в веб-интерфейсе Kaspi POS)
KASPI_TOKEN_SN=
KASPI_PROFILE_ID=
KASPI_VTOKEN_SECRET=
