<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="IIKO_LOYALTY_API_BASE_URL" value="https://iiko-bonus.onrender.com/api/loyalty" />
    <add key="IIKO_LOYALTY_API_TOKEN" value="REPLACE_WITH_API_SECRET" />
    <add key="IIKO_LOYALTY_TIMEOUT_SEC" value="10" />
    <add key="IIKO_LOYALTY_RETRY_INTERVAL_SEC" value="60" />
    <add key="IIKO_LOYALTY_MAX_ATTEMPTS" value="0" />
  </appSettings>
</configuration>
