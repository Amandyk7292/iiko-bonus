<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="IIKO_LOYALTY_API_BASE_URL" value="https://bulka.com.kz/api/loyalty" />
    <add key="IIKO_LOYALTY_API_TOKEN" value="" />
    <add key="IIKO_LOYALTY_DISCOUNT_TYPE_NAME" value="Bulka Bonus" />
    <!-- If several similar discount types exist, set the exact iiko discount UUID below. -->
    <add key="IIKO_LOYALTY_DISCOUNT_TYPE_ID" value="" />
    <!-- UUID филиала из раздела «Локации» админки. Нужен для QR/PIN-выдачи онлайн-заказов. -->
    <add key="IIKO_BRANCH_ID" value="" />
    <!-- Уникальный секрет кассы/филиала, который создаётся в админке Bulka. -->
    <add key="IIKO_BRANCH_POS_TOKEN" value="" />
    <!-- Отдельная гибкая скидка для оплаты подарочным сертификатом. Не используйте тип Bulka Bonus. -->
    <add key="IIKO_GIFT_DISCOUNT_TYPE_NAME" value="Bulka Gift Certificate" />
    <add key="IIKO_GIFT_DISCOUNT_TYPE_ID" value="" />
    <add key="IIKO_GIFT_RESERVATION_TTL_MIN" value="120" />
    <add key="IIKO_LOYALTY_TIMEOUT_SEC" value="8" />
    <add key="IIKO_LOYALTY_RETRY_INTERVAL_SEC" value="60" />
    <add key="IIKO_LOYALTY_MAX_ATTEMPTS" value="0" />
  </appSettings>
</configuration>
