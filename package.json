{
  "name": "iiko-bonus-backend",
  "version": "1.0.0",
  "description": "Backend for iiko external loyalty system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "test": "node --test test/*.test.js",
    "check:supabase": "node scripts/check-supabase.js",
    "db:migrate:check": "node scripts/apply-migrations.js",
    "db:migrate": "node scripts/apply-migrations.js --apply",
    "build:admin": "npm --prefix admin-ui run build",
    "build": "npm run build:admin",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@parse/node-apn": "^8.1.0",
    "@supabase/supabase-js": "^2.110.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "adm-zip": "^0.5.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "node-fetch": "^2.7.0",
    "node-forge": "^1.4.0",
    "passkit-generator": "^3.5.7",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.4"
  },
  "overrides": {
    "joi": "17.13.4",
    "uuid": "11.1.1"
  }
}
