<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bulka_widget_background"
    android:clickable="true"
    android:contentDescription="@string/widget_accessibility_signed_out"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:importantForAccessibility="no"
            android:text="Bulka"
            android:textColor="@color/bulka_widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_loyalty"
            android:textAllCaps="true"
            android:textColor="@color/bulka_widget_gold"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_signed_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:importantForAccessibility="no"
            android:text="@string/widget_balance_label"
            android:textAllCaps="true"
            android:textColor="@color/bulka_widget_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:text="0 ₸"
            android:textColor="@color/bulka_widget_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_no_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_no_active_order"
            android:textColor="@color/bulka_widget_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/widget_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bulka_widget_order_background"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:paddingLeft="11dp"
            android:paddingTop="8dp"
            android:paddingRight="11dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_order_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textColor="@color/bulka_widget_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_order_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/bulka_widget_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="›"
                android:textColor="@color/bulka_widget_gold"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_signed_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/widget_signed_out_title"
            android:textColor="@color/bulka_widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:text="@string/widget_signed_out_body"
            android:textColor="@color/bulka_widget_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
